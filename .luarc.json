{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "codeLens": {
    "enable": true
  },
  "hint": {
    "enable": true,
    "arrayIndex": "Disable",
    "semicolon": "Disable"
  },
  "runtime": {
    "path": ["?.lua", "?/init.lua"],
    "pathStrict": true,
    "version": "Lua 5.4"
  },
  "workspace": {
    "library": [
      "lua54/share/lua/5.4",
      "lua54/share/lua/5.4/wezterm/types",
      "lua54/share/lua/5.4/busted",
      "lua54/share/lua/5.4/luassert"
    ],
    "checkThirdParty": false,
    "ignoreDir": ["/lua"]
  }
}
